+def _name_hit(q, bare):
+    """学生话里有没有直接点名这道菜；返回命中片段长度（9=整名命中，0=没命中）"""
+    if len(bare) >= 2 and bare in q:
+        return 9
+    best = 0
+    for n in (3, 2):
+        for i in range(len(q) - n + 1):
+            seg = q[i:i + n]
+            if seg in STOP_GRAMS:
+                continue
+            if seg in bare:
+                best = max(best, n)
+    return best
